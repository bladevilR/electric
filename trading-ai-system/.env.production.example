# JSPEC local collection
JSPEC_BASE_URL=https://example-jspec-host
JSPEC_USERNAME=replace-with-operator

# Do not commit JSPEC_PASSWORD, UKey PIN, browser profile data, or API keys.

# CA / UKey manual confirmation metadata
CA_UKEY_PROVIDER=replace-with-provider
CA_UKEY_CERT_ID=replace-with-cert-id

# Optional trading platform page location
TRADING_PLATFORM_URL=https://example-trading-platform

# Human review identities
TRADING_OPERATOR_ID=replace-with-operator-id
TRADING_APPROVER_ID=replace-with-approver-id

# Execution mode
EXECUTION_MODE=human_decision_only

# Local audit log path
TRADING_AUDIT_LOG=E:\electric\trading-ai-system\data\audit-log.ndjson

# OpenAI-compatible model runtime
OPENAI_BASE_URL=https://kimi.a7m.com.cn/v1
OPENAI_MODEL=kimi-k2.6
OPENAI_API_KEY=replace-with-your-key
