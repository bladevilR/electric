{
  "version": 1,
  "title": "电力交易 AI · 智能交易副驾驶参赛演示",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "durationMs": 236000,
  "segments": [
    {
      "id": "intro",
      "title": "电力交易 AI · 让每一次申报更接近真实需求",
      "narration": "电力交易中，申报多一点、少一点，最终都会反映在结算成本里。面对每天九十六个交易时点，AI的价值，是帮助企业减少偏差，降低交易成本。",
      "narrationChapter": "chapter-cost",
      "durationMs": 10000,
      "startMs": 0,
      "endMs": 11069,
      "status": "completed"
    },
    {
      "id": "opening",
      "title": "AI 电力交易副驾驶",
      "narration": "这套系统不是只做一次预测，而是把数据、预测、申报、复核和结算连成一条降低交易成本的闭环。交易员看到的不只是建议，还有每一项调整可能减少的成本。",
      "narrationChapter": "chapter-cost",
      "durationMs": 16000,
      "startMs": 11069,
      "endMs": 28201,
      "status": "completed"
    },
    {
      "id": "savings-impact",
      "title": "成本优化结果",
      "narration": "在当前演示交易规模下，单日净成本优化额为2.4万元；按二十二个交易日测算，月度约52.8万元；按二百六十四个交易日测算，年度节约潜力约633.6万元。所有金额都可以继续展开核算。",
      "narrationChapter": "chapter-cost",
      "durationMs": 18000,
      "startMs": 28201,
      "endMs": 47309,
      "status": "completed"
    },
    {
      "id": "data-quality",
      "title": "数据接入与质量门禁",
      "narration": "节约成本的第一步，不是立即给出交易量，而是先确认数据是否可信。系统统一检查市场价格、负荷预测、持仓、交易限额和数据新鲜度；任何关键数据缺失或过期，都会明确阻断后续决策。",
      "narrationChapter": "chapter-data",
      "durationMs": 13000,
      "startMs": 47309,
      "endMs": 61410,
      "status": "completed"
    },
    {
      "id": "validation-evidence",
      "title": "执行前数据校验",
      "narration": "校验结果不是一个模糊的绿灯。每一类数据都显示来源、数量、更新时间和是否满足执行条件，让交易员知道系统为什么允许继续，或者为什么必须暂停。",
      "narrationChapter": "chapter-data",
      "durationMs": 14000,
      "startMs": 61411,
      "endMs": 76559,
      "status": "completed"
    },
    {
      "id": "prediction-proof",
      "title": "预测效果验证",
      "narration": "数据通过后，AI结合历史负荷、价格和时段特征形成预测。系统同时保留留出集误差、交易日胜率和基线对比，只有真正优于基线的模型，才可以进入申报优化。",
      "narrationChapter": "chapter-data",
      "durationMs": 15000,
      "startMs": 76559,
      "endMs": 92652,
      "status": "completed"
    },
    {
      "id": "return-curve",
      "title": "回到 AI 申报优化",
      "narration": "预测本身不会自动省钱。系统需要把负荷和价格判断继续转化为每个交易时点的申报动作，并在市场约束和风险边界内寻找更低成本的方案。",
      "narrationChapter": "chapter-optimize",
      "durationMs": 16000,
      "startMs": 92652,
      "endMs": 109757,
      "status": "completed"
    },
    {
      "id": "curve",
      "title": "96 点申报曲线",
      "narration": "这里逐点比较历史申报和AI建议。系统识别成本影响最大的窗口，告诉交易员哪些时段应该上调、哪些时段应该下调，同时保留完整的九十六点曲线，而不是只给一句笼统结论。",
      "narrationChapter": "chapter-optimize",
      "durationMs": 18000,
      "startMs": 109757,
      "endMs": 128993,
      "status": "completed"
    },
    {
      "id": "recommendation",
      "title": "AI 优化建议",
      "narration": "右侧建议把预计偏差改善、关键调整时段和运行状态集中呈现。交易员可以快速看出方案为什么更省钱、收益来自哪里，以及当前是否具备进入人工复核的条件。",
      "narrationChapter": "chapter-optimize",
      "durationMs": 16000,
      "startMs": 128993,
      "endMs": 146348,
      "status": "completed"
    },
    {
      "id": "open-evidence",
      "title": "打开成本优化证据链",
      "narration": "为了避免把预测价差直接当成收益，系统为建议建立成本证据链。交易员可以核对输入来源、计算公式、数据新鲜度和最近操作记录，确认数字与当前交易日采用同一口径。",
      "narrationChapter": "chapter-review",
      "durationMs": 16000,
      "startMs": 146349,
      "endMs": 163618,
      "status": "completed"
    },
    {
      "id": "close-evidence",
      "title": "完成证据核对",
      "narration": "证据核对完成后，返回主流程。",
      "narrationChapter": "chapter-review",
      "durationMs": 4000,
      "startMs": 163618,
      "endMs": 168996,
      "status": "completed"
    },
    {
      "id": "human-review",
      "title": "人工复核保留最终决定权",
      "narration": "AI负责汇总、预测、计算和解释，交易员保留最终决定权。进入真实申报前，人员必须复核关键时段、风险边界和成本依据；未经复核，系统不会自动提交交易。",
      "narrationChapter": "chapter-review",
      "durationMs": 14000,
      "startMs": 168996,
      "endMs": 184411,
      "status": "completed"
    },
    {
      "id": "audit-mode",
      "title": "结算统计与审计回流",
      "narration": "交易完成后，执行与结算结果回流系统。单日2.4万元净成本优化额，来自基准成本减去实际结算、手续费、偏差成本和系统运行成本；五项明细完整相减，结果正好一致。",
      "narrationChapter": "chapter-review",
      "durationMs": 13000,
      "startMs": 184412,
      "endMs": 198736,
      "status": "completed"
    },
    {
      "id": "open-evolution",
      "title": "AI 持续改进策略",
      "narration": "结算结果继续反哺下一次决策。系统生成候选策略，经过回测和影子运行，再由人员审批。",
      "narrationChapter": "chapter-outro",
      "durationMs": 10000,
      "startMs": 198736,
      "endMs": 209818,
      "status": "completed"
    },
    {
      "id": "evolution-proof",
      "title": "候选策略只是持续学习的证据",
      "narration": "挑战者只是持续学习的证据。新版本不会自动上线或申报，始终保留人工审批和回滚。",
      "narrationChapter": "chapter-outro",
      "durationMs": 8000,
      "startMs": 209819,
      "endMs": 219421,
      "status": "completed"
    },
    {
      "id": "outro",
      "title": "让每一笔节约都有依据",
      "narration": "从预测需求、优化申报到复盘偏差成本，AI让节约有依据、决策可复核。按演示规模测算，年度节约潜力约633.6万元。",
      "narrationChapter": "chapter-outro",
