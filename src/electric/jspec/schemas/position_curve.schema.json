{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bladevilr.local/electric/jspec/position_curve.schema.json",
  "title": "JSPEC Manual Export Position Curve Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_date",
    "position_mwh",
    "source_file",
    "exported_at",
    "parsed_at",
    "parser_version",
    "contains_credentials"
  ],
  "anyOf": [
    { "required": ["trade_hour"] },
    { "required": ["point_index"] }
  ],
  "properties": {
    "month": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}$" },
    "trade_date": { "type": ["string", "null"], "format": "date" },
    "execution_date": { "type": "string", "format": "date" },
    "trade_hour": { "type": ["integer", "null"], "minimum": 0, "maximum": 24 },
    "point_index": { "type": ["integer", "null"], "minimum": 1, "maximum": 96 },
    "position_mwh": { "type": ["number", "null"] },
    "traded_mwh": { "type": ["number", "null"], "minimum": 0 },
    "adjustable_buy_mwh": { "type": ["number", "null"], "minimum": 0 },
    "adjustable_sell_mwh": { "type": ["number", "null"], "minimum": 0 },
    "product_type": { "type": ["string", "null"] },
    "source_file": { "type": "string", "minLength": 1 },
    "exported_at": { "type": "string" },
    "parsed_at": { "type": "string" },
    "parser_version": { "type": "string", "minLength": 1 },
    "contains_credentials": { "const": false },
    "notes": { "type": ["string", "null"] }
  }
}
